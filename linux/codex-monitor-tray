#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
Codex Monitor Tray (Cross-Platform Top Bar & System Tray)
跨平台任务栏 / 状态栏常驻小工具
- Linux: 常驻在 Ubuntu / GNOME 顶部状态栏 (Top Bar AppIndicator)
- Windows: 常驻在 Windows 屏幕右下角任务栏托盘 (System Tray)
显示实时用量：⚡ 68% (5d)
"""

import os
import sys
import json
import time
import base64
import threading
import urllib.request
import urllib.error

# 1. 查找凭据文件
def find_auth_json():
    candidates = [
        os.getenv("CODEX_AUTH_PATH"),
        os.path.join(os.getenv("CODEX_HOME", ""), "auth.json"),
        os.path.expanduser("~/.codex/auth.json"),
        os.path.expanduser("~/.cc-switch/current/auth.json"),
        os.path.expanduser("~/.cc-switch/auth.json"),
        os.path.expanduser("~/.config/cc-switch/auth.json"),
        os.path.join(os.environ.get("USERPROFILE", ""), ".codex", "auth.json"),
        "/root/.codex/auth.json",
        "/root/.cc-switch/current/auth.json",
        "/root/.cc-switch/auth.json",
        "/root/.config/cc-switch/auth.json",
    ]
    for c in candidates:
        if c and os.path.isfile(c):
            try:
                real_p = os.path.realpath(c)
                if os.path.isfile(real_p):
                    return real_p
            except Exception:
                return c
    return None

def fetch_local_auth():
    auth_info = {
        "access_token": "",
        "refresh_token": "",
        "account_id": "",
        "email": "未登录",
        "plan_type": "--",
        "subscription_expiry": "--",
        "auth_path": ""
    }
    p = find_auth_json()
    if not p:
        return auth_info

    auth_info["auth_path"] = p
    try:
        with open(p, "r", encoding="utf-8") as f:
            data = json.load(f)

        tokens = data.get("tokens", {}) if isinstance(data.get("tokens"), dict) else data
        access_token = tokens.get("access_token", "")
        refresh_token = tokens.get("refresh_token", "")
        id_token = tokens.get("id_token", "")
        account_id = tokens.get("account_id", "")

        tok = id_token if id_token else access_token
        email = ""
        plan_type = "ChatGPT Plus"
        sub_until = "--"

        if tok and "." in tok:
            parts = tok.split(".")
            if len(parts) >= 2:
                b64 = parts[1] + "=" * (4 - len(parts[1]) % 4)
                payload = json.loads(base64.urlsafe_b64decode(b64.encode()))
                email = payload.get("email", "")
                if not email and "https://api.openai.com/profile" in payload:
                    email = payload["https://api.openai.com/profile"].get("email", "")

                auth_obj = payload.get("https://api.openai.com/auth", {})
                if isinstance(auth_obj, dict):
                    pt = auth_obj.get("chatgpt_plan_type", "plus").lower()
                    if "pro" in pt: plan_type = "ChatGPT Pro"
                    elif "plus" in pt: plan_type = "ChatGPT Plus"
                    elif "team" in pt: plan_type = "ChatGPT Team"
                    else: plan_type = "ChatGPT " + pt.capitalize()

                    raw_until = auth_obj.get("chatgpt_subscription_active_until", "")
                    if raw_until:
                        sub_until = raw_until[:16].replace("T", " ")

        auth_info["access_token"] = access_token
        auth_info["refresh_token"] = refresh_token
        auth_info["account_id"] = account_id
        auth_info["email"] = email if email else "ChatGPT 用户"
        auth_info["plan_type"] = plan_type
        auth_info["subscription_expiry"] = sub_until
    except Exception:
        pass

    return auth_info

def auto_refresh_token(auth_info):
    ref_tok = auth_info.get("refresh_token")
    if not ref_tok:
        return None

    proxy_url = os.environ.get("https_proxy") or os.environ.get("HTTPS_PROXY") or \
                os.environ.get("http_proxy") or os.environ.get("HTTP_PROXY") or \
                os.environ.get("all_proxy") or os.environ.get("ALL_PROXY")
    opener = urllib.request.build_opener()
    if proxy_url:
        if not proxy_url.startswith("http"):
            proxy_url = "http://" + proxy_url
        opener.add_handler(urllib.request.ProxyHandler({'http': proxy_url, 'https': proxy_url}))

    body = json.dumps({
        "client_id": "app_EMoamEEZ73f0CkXaXp7hrann",
        "grant_type": "refresh_token",
        "refresh_token": ref_tok
    }).encode("utf-8")

    req = urllib.request.Request("https://auth.openai.com/oauth/token", data=body)
    req.add_header("Content-Type", "application/json")
    req.add_header("User-Agent", "Mozilla/5.0 (Windows NT 10.0; Win64; x64)")

    try:
        with opener.open(req, timeout=10) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            new_acc = data.get("access_token")
            new_ref = data.get("refresh_token")
            if new_acc and auth_info.get("auth_path"):
                p = auth_info["auth_path"]
                try:
                    with open(p, "r", encoding="utf-8") as f:
                        file_data = json.load(f)
                    if "tokens" in file_data and isinstance(file_data["tokens"], dict):
                        file_data["tokens"]["access_token"] = new_acc
                        if new_ref: file_data["tokens"]["refresh_token"] = new_ref
                    else:
                        file_data["access_token"] = new_acc
                        if new_ref: file_data["refresh_token"] = new_ref
                    with open(p, "w", encoding="utf-8") as f:
                        json.dump(file_data, f, indent=2)
                except Exception:
                    pass
                return new_acc
    except Exception:
        pass
    return None

class CrossPlatformTrayMonitor:
    def __init__(self):
        self.percentage_str = "--"
        self.reset_cd = "--"
        self.reset_detail = "正在连接网络..."
        self.email = "检测中..."
        self.plan_type = "--"
        self.subscription_expiry = "--"

    def fetch_data(self):
        auth = fetch_local_auth()
        self.email = auth["email"]
        self.plan_type = auth["plan_type"]
        self.subscription_expiry = auth["subscription_expiry"]

        if not auth["access_token"]:
            new_tok = auto_refresh_token(auth)
            if new_tok:
                auth["access_token"] = new_tok
            else:
                self.percentage_str = "--"
                self.reset_cd = "--"
                self.reset_detail = "未检测到本地凭据"
                return

        proxy_url = os.environ.get("https_proxy") or os.environ.get("HTTPS_PROXY") or \
                    os.environ.get("http_proxy") or os.environ.get("HTTP_PROXY") or \
                    os.environ.get("all_proxy") or os.environ.get("ALL_PROXY")
        
        opener = urllib.request.build_opener()
        if proxy_url:
            if not proxy_url.startswith("http"):
                proxy_url = "http://" + proxy_url
            opener.add_handler(urllib.request.ProxyHandler({'http': proxy_url, 'https': proxy_url}))

        def make_req(tok):
            r = urllib.request.Request("https://chatgpt.com/backend-api/wham/usage")
            r.add_header("Authorization", "Bearer " + tok)
            r.add_header("User-Agent", "Mozilla/5.0 (Windows NT 10.0; Win64; x64)")
            r.add_header("Accept", "application/json")
            r.add_header("Origin", "https://chatgpt.com")
            r.add_header("Referer", "https://chatgpt.com/")
            if auth["account_id"]:
                r.add_header("chatgpt-account-id", auth["account_id"])
            return r

        try:
            try:
                resp = opener.open(make_req(auth["access_token"]), timeout=9)
            except urllib.error.HTTPError as he:
                if he.code == 401:
                    new_tok = auto_refresh_token(auth)
                    if new_tok:
                        auth["access_token"] = new_tok
                        resp = opener.open(make_req(new_tok), timeout=9)
                    else:
                        raise he
                else:
                    raise he

            data = json.loads(resp.read().decode("utf-8"))
            rate_limit = data.get("rate_limit", {})
            primary = rate_limit.get("primary_window", {}) if rate_limit else {}
            used_pct = float(primary.get("used_percent", 0.0))
            pct_val = max(0.0, min(100.0, 100.0 - used_pct))
            self.percentage_str = f"{int(pct_val)}%"
            sec = int(primary.get("reset_after_seconds", 0))

            days = sec // 86400
            hours = (sec % 86400) // 3600
            mins = (sec % 3600) // 60

            if days > 0:
                self.reset_cd = f"{days}d"
                self.reset_detail = f"{days}天 {hours}小时后"
            elif hours > 0:
                self.reset_cd = f"{hours}h"
                self.reset_detail = f"{hours}小时 {mins}分钟后"
            else:
                self.reset_cd = f"{mins}m"
                self.reset_detail = f"{mins}分钟后"
        except Exception:
            self.reset_detail = "正在连接网络..."

    def run_windows_tray(self):
        """Windows 本地测试：使用简易 Tkinter 模拟 Windows 任务栏菜单与状态"""
        import tkinter as tk
        from tkinter import Menu

        root = tk.Tk()
        root.title("Codex Monitor Tray (Windows 测试模式)")
        root.geometry("380x280+350+300")
        root.configure(bg="#0E1118")

        title_lbl = tk.Label(root, text="⚡ 正在加载任务栏状态...", font=("Segoe UI", 16, "bold"), fg="#38BDF8", bg="#0E1118", pady=15)
        title_lbl.pack()

        frame = tk.Frame(root, bg="#181C26", bd=1, relief="solid", highlightbackground="#2D3748", highlightthickness=1)
        frame.pack(padx=20, pady=5, fill="both", expand=True)

        lbl_email = tk.Label(frame, text="📧 账号: 加载中...", font=("Segoe UI", 10), fg="#F1F5F9", bg="#181C26", anchor="w", padx=15, pady=4)
        lbl_email.pack(fill="x")

        lbl_plan = tk.Label(frame, text="💎 类型: 加载中...", font=("Segoe UI", 10), fg="#F1F5F9", bg="#181C26", anchor="w", padx=15, pady=4)
        lbl_plan.pack(fill="x")

        lbl_expiry = tk.Label(frame, text="📅 到期: 加载中...", font=("Segoe UI", 10), fg="#F1F5F9", bg="#181C26", anchor="w", padx=15, pady=4)
        lbl_expiry.pack(fill="x")

        lbl_reset = tk.Label(frame, text="⏱️ 重置: 加载中...", font=("Segoe UI", 10), fg="#F1F5F9", bg="#181C26", anchor="w", padx=15, pady=4)
        lbl_reset.pack(fill="x")

        btn_box = tk.Frame(root, bg="#0E1118", pady=10)
        btn_box.pack(fill="x")

        def update_ui():
            title_lbl.config(text=f"⚡ 任务栏显示: ⚡ {self.percentage_str} ({self.reset_cd})")
            lbl_email.config(text=f"📧 账号: {self.email}")
            lbl_plan.config(text=f"💎 类型: {self.plan_type}")
            lbl_expiry.config(text=f"📅 到期: {self.subscription_expiry}")
            lbl_reset.config(text=f"⏱️ 重置: {self.reset_detail}")

        def do_refresh():
            def _th():
                self.fetch_data()
                root.after(0, update_ui)
            threading.Thread(target=_th, daemon=True).start()

        btn_refresh = tk.Button(btn_box, text="🔄 立即刷新", font=("Segoe UI", 9, "bold"), bg="#2563EB", fg="#FFFFFF", activebackground="#1D4ED8", bd=0, padx=12, pady=5, command=do_refresh)
        btn_refresh.pack(side="left", padx=25)

        btn_quit = tk.Button(btn_box, text="❌ 退出测试", font=("Segoe UI", 9), bg="#374151", fg="#F1F5F9", activebackground="#4B5563", bd=0, padx=12, pady=5, command=root.destroy)
        btn_quit.pack(side="right", padx=25)

        do_refresh()
        root.mainloop()

    def run_linux_gtk(self):
        """Linux 原生顶部状态栏 AppIndicator"""
        import gi
        gi.require_version('Gtk', '3.0')
        try:
            gi.require_version('AppIndicator3', '0.1')
            from gi.repository import AppIndicator3 as appindicator
        except Exception:
            try:
                gi.require_version('AyatanaAppIndicator3', '0.1')
                from gi.repository import AyatanaAppIndicator3 as appindicator
            except Exception:
                appindicator = None

        from gi.repository import Gtk, GLib

        if appindicator:
            indicator = appindicator.Indicator.new(
                "codex-monitor",
                "utilities-system-monitor",
                appindicator.IndicatorCategory.APPLICATION_STATUS
            )
            indicator.set_status(appindicator.IndicatorStatus.ACTIVE)
            indicator.set_label("⚡ --", "100%")
        else:
            indicator = None

        menu = Gtk.Menu()
        status_item = Gtk.MenuItem(label="⚡ 额度: --")
        status_item.set_sensitive(False)
        menu.append(status_item)

        menu.append(Gtk.SeparatorMenuItem())
        email_item = Gtk.MenuItem(label="📧 账号: --")
        email_item.set_sensitive(False)
        menu.append(email_item)

        plan_item = Gtk.MenuItem(label="💎 类型: --")
        plan_item.set_sensitive(False)
        menu.append(plan_item)

        expiry_item = Gtk.MenuItem(label="📅 到期: --")
        expiry_item.set_sensitive(False)
        menu.append(expiry_item)

        reset_item = Gtk.MenuItem(label="⏱️ 重置: --")
        reset_item.set_sensitive(False)
        menu.append(reset_item)

        menu.append(Gtk.SeparatorMenuItem())
        refresh_item = Gtk.MenuItem(label="🔄 立即刷新")
        refresh_item.connect("activate", lambda _: threading.Thread(target=self.fetch_data, daemon=True).start())
        menu.append(refresh_item)

        quit_item = Gtk.MenuItem(label="❌ 退出")
        quit_item.connect("activate", lambda _: Gtk.main_quit())
        menu.append(quit_item)

        menu.show_all()
        if indicator:
            indicator.set_menu(menu)

        def update_ui():
            label_text = f"⚡ {self.percentage_str} ({self.reset_cd})"
            if indicator:
                indicator.set_label(label_text, "100% (99d)")
            status_item.set_label(f"⚡ 剩余额度: {self.percentage_str} (重置倒计时: {self.reset_cd})")
            email_item.set_label(f"📧 账号: {self.email}")
            plan_item.set_label(f"💎 类型: {self.plan_type}")
            expiry_item.set_label(f"📅 到期: {self.subscription_expiry}")
            reset_item.set_label(f"⏱️ 重置: {self.reset_detail}")
            return False

        def poll_loop():
            while True:
                self.fetch_data()
                GLib.idle_add(update_ui)
                time.sleep(60)

        threading.Thread(target=poll_loop, daemon=True).start()
        Gtk.main()

