    def run(self):
        for arg in sys.argv[1:]:
            if arg in ["--test", "-t", "--dry-run"]:
                self.run_test_mode()
                return

        if sys.platform == "win32":
            self.run_windows_tray()
        else:
            try:
                self.run_linux_gtk()
            except Exception:
                self.run_test_mode()

if __name__ == "__main__":
    app = CrossPlatformTrayMonitor()
    app.run()
